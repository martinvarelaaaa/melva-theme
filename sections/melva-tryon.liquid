{%- comment -%}
  Melva — Probador Virtual (MVP)
  Botón "Probatelo" en la PDP + modal de subida de foto + render con Gemini (server-side en Firebase Functions).
  No requiere apps externas. Endpoint configurable en el editor de temas.
{%- endcomment -%}

{%- liquid
  assign endpoint = section.settings.endpoint | strip
  assign enabled = section.settings.enabled
-%}

{%- if enabled and product and endpoint != blank -%}
  {%- assign tryon_img = product.featured_media | image_url: width: 1024 -%}
  <div
    id="MelvaTryon"
    class="melva-tryon-root"
    data-endpoint="{{ endpoint }}"
    data-product-handle="{{ product.handle }}"
    data-product-title="{{ product.title | escape }}"
    data-product-img="{{ tryon_img }}"
    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
    data-added-label="{{ section.settings.added_label }}"
  >
    <button
      type="button"
      class="melva-tryon-open button button--full-width button--secondary"
      aria-haspopup="dialog"
    >
      <svg class="melva-tryon-cam" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v12H4z" stroke-linejoin="round"/><circle cx="12" cy="13.5" r="3.6"/></svg>
      {{ section.settings.button_label }}
    </button>

    <div class="melva-tryon-modal" id="MelvaTryonModal" hidden role="dialog" aria-modal="true" aria-label="{{ section.settings.button_label }}">
      <div class="melva-tryon-backdrop" data-tryon-close></div>
      <div class="melva-tryon-card">
        <button type="button" class="melva-tryon-x" data-tryon-close aria-label="Cerrar">✕</button>

        {%- comment -%} Paso 1: subida {%- endcomment -%}
        <div class="melva-tryon-step" data-step="upload">
          <h3 class="melva-tryon-title">{{ section.settings.modal_title }}</h3>
          <p class="melva-tryon-sub">{{ section.settings.modal_help }}</p>
          <div class="melva-tryon-dropzone" data-tryon-pick tabindex="0" role="button" aria-label="Elegir foto">
            <span class="melva-tryon-dropzone-emoji">📷</span>
            <span class="melva-tryon-dropzone-text">Tocá para elegir una foto</span>
            <span class="melva-tryon-dropzone-hint">De pie, buena luz, ropa ajustada al cuerpo</span>
          </div>
          <input type="file" accept="image/*" class="melva-tryon-file" hidden>
          <label class="melva-tryon-consent">
            <input type="checkbox" id="MelvaTryonConsent">
            <span>{{ section.settings.consent_text }}</span>
          </label>
          <button type="button" class="melva-tryon-go button button--full-width" disabled data-tryon-go>
            {{ section.settings.generate_label }}
          </button>
        </div>

        {%- comment -%} Paso 2: esperando {%- endcomment -%}
        <div class="melva-tryon-step" data-step="loading" hidden>
          <div class="melva-tryon-shimmer" aria-hidden="true"></div>
          <p class="melva-tryon-loading-text">{{ section.settings.loading_text }}</p>
        </div>

        {%- comment -%} Paso 3: resultado {%- endcomment -%}
        <div class="melva-tryon-step" data-step="result" hidden>
          <img class="melva-tryon-result-img" alt="Probando {{ product.title | escape }}" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7">
          <div class="melva-tryon-actions">
            <button type="button" class="melva-tryon-add button button--full-width" data-tryon-cart>
              {{ section.settings.cart_label }}
            </button>
            <div class="melva-tryon-actions-row">
              <button type="button" class="melva-tryon-ghost" data-tryon-retry>Otra foto</button>
              <button type="button" class="melva-tryon-ghost" data-tryon-close>Cerrar</button>
            </div>
          </div>
        </div>

        {%- comment -%} Paso 4: error {%- endcomment -%}
        <div class="melva-tryon-step" data-step="error" hidden>
          <p class="melva-tryon-error-text" data-tryon-error></p>
          <button type="button" class="melva-tryon-ghost" data-tryon-retry>Intentar de nuevo</button>
        </div>

        {%- comment -%} Paso 5: agregado al carrito {%- endcomment -%}
        <div class="melva-tryon-step" data-step="added" hidden>
          <p class="melva-tryon-added-text" data-tryon-added-text>✓ {{ section.settings.added_label }}</p>
          <div class="melva-tryon-actions-row">
            <a href="/cart" class="melva-tryon-ghost">Ver carrito</a>
            <button type="button" class="melva-tryon-ghost" data-tryon-close>Seguir mirando</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  {{ 'melva-tryon.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'melva-tryon.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Melva Probador",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Activar probador virtual", "default": true },
    {
      "type": "text",
      "id": "endpoint",
      "label": "Endpoint del servicio (Cloud Function)",
      "info": "Ej: https://us-central1-PROJECT.cloudfunctions.net/tryon"
    },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Probatelo" },
    { "type": "text", "id": "modal_title", "label": "Título del modal", "default": "Probatelo" },
    {
      "type": "textarea",
      "id": "modal_help",
      "label": "Instrucción",
      "default": "Subí una foto tuya y te mostramos con esta prenda puesta."
    },
    {
      "type": "textarea",
      "id": "consent_text",
      "label": "Texto de consentimiento",
      "default": "Acepto que mi foto se use solo para generar esta imagen y no se guarde."
    },
    { "type": "text", "id": "generate_label", "label": "Botón generar", "default": "Ver cómo me queda" },
    { "type": "text", "id": "loading_text", "label": "Texto esperando", "default": "Estamos vistiéndote…" },
    { "type": "text", "id": "cart_label", "label": "Botón carrito", "default": "Agregar al carrito" },
    { "type": "text", "id": "added_label", "label": "Texto agregado", "default": "Agregado al carrito" }
  ],
  "presets": [{ "name": "Melva Probador" }]
}
{% endschema %}
