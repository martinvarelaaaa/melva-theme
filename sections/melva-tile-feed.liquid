{% comment %}
  Feed shoppable estilo IG — Melva.
  Mosaico 2col/3col de variaciones de color (foto full-bleed = la prenda es el héroe).
  Chip discreto con título+color+precio. "+" = quick add (hoja de talles mínima).
  Animación sutil de entrada al scroll (sin reduced-motion). Reemplaza a la grilla
  de productos en la home: una sola sección de descubrimiento.
{% endcomment %}

{%- liquid
  assign feed_products = collections.all.products
  assign max_tiles = section.settings.max_tiles | default: 18
-%}

{%- if feed_products.size > 0 -%}
<section class="melva-feed">
  <ul class="melva-feed__grid" role="list">
    {%- assign tile_count = 0 -%}
    {%- assign sale_products = '' -%}
    {%- assign normal_products = '' -%}
    {%- for feed_product in feed_products limit: 40 -%}
      {%- if feed_product.compare_at_price > feed_product.price -%}
        {%- assign sale_products = sale_products | append: feed_product.id | append: ',' -%}
      {%- else -%}
        {%- assign normal_products = normal_products | append: feed_product.id | append: ',' -%}
      {%- endif -%}
    {%- endfor -%}

    {%- for feed_round in (0..1) -%}
      {%- if tile_count >= max_tiles -%}{%- break -%}{%- endif -%}
      {%- if feed_round == 0 and section.settings.prioritize_sale -%}
        {%- for feed_product in feed_products limit: 40 -%}
          {%- if tile_count >= max_tiles -%}{%- break -%}{%- endif -%}
          {%- if sale_products contains feed_product.id -%}
            {%- include 'melva-feed-tiles', feed_product: feed_product -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {%- if feed_round == 1 or section.settings.prioritize_sale == false -%}
        {%- for feed_product in feed_products limit: 40 -%}
          {%- if tile_count >= max_tiles -%}{%- break -%}{%- endif -%}
          {%- unless feed_round == 1 and section.settings.prioritize_sale and sale_products contains feed_product.id -%}
            {%- include 'melva-feed-tiles', feed_product: feed_product -%}
          {%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
  </ul>

  {%- comment -%} Hoja de quick-add (talles) {%- endcomment -%}
  <div class="melva-qs" id="MelvaQuickAdd" hidden role="dialog" aria-modal="true" aria-label="Elegir talle">
    <div class="melva-qs__backdrop" data-qs-close></div>
    <div class="melva-qs__card">
      <button type="button" class="melva-qs__x" data-qs-close aria-label="Cerrar">✕</button>
      <img class="melva-qs__img" alt="" hidden>
      <h3 class="melva-qs__title"></h3>
      <p class="melva-qs__price"></p>
      <div class="melva-qs__sizes" role="radiogroup" aria-label="Talle"></div>
      <button type="button" class="melva-qs__add button button--full-width" data-qs-add disabled>Agregar al carrito</button>
      <p class="melva-qs__done" hidden>✓ Agregado al carrito</p>
    </div>
  </div>

  <script>
  window.MELVA_FEED = { items: [
    {%- for product in collections.all.products -%}
    { h: {{ product.handle | json }}, t: {{ product.title | json }}, c: [
      {%- assign seen_c = '' -%}
      {%- for variant in product.variants -%}
        {%- assign cc = variant.option1 | strip | append: ',' -%}
        {%- unless seen_c contains cc -%}
          {%- assign seen_c = seen_c | append: cc -%}
          { color: {{ variant.option1 | json }},
            img: {% if variant.image %}{{ variant.image | image_url: width: 720 | json }}{% else %}null{% endif %},
            price: {{ variant.price | money | json }},
            sizes: [
              {%- for v2 in product.variants -%}
                {%- if v2.option1 != variant.option1 -%}{%- continue -%}{%- endif -%}
                { id: {{ v2.id }}, s: {{ v2.option2 | json }}, a: {{ v2.available | json }} },
              {%- endfor -%}
            ] },
        {%- endunless -%}
      {%- endfor -%}
    ] },
    {%- endfor -%}
  ] };

  (function () {
    'use strict';

    /* ---- entrada al scroll: delays y offsets aleatorios (orgánico, no mecánico) ---- */
    var cells = document.querySelectorAll('.melva-feed__cell');
    Array.prototype.forEach.call(cells, function (li) {
      li.style.setProperty('--d', Math.round(Math.random() * 220) + 'ms');
      li.style.setProperty('--x', (Math.round(Math.random() * 16) - 8) + 'px');
    });
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
      Array.prototype.forEach.call(cells, function (li) { io.observe(li); });
    } else {
      Array.prototype.forEach.call(cells, function (li) { li.classList.add('is-in'); });
    }

    /* ---- swipe horizontal por color dentro de cada tile ---- */
    function bindScroller(li) {
      var sc = li.querySelector('[data-scroller]');
      if (!sc) return;
      var colors = window.MELVA_FEED.items.filter(function (x) { return x.h === li.dataset.handle; })[0];
      var chipColor = li.querySelector('[data-chip-color]');
      var dots = li.querySelectorAll('.melva-tile__dot');
      var ticking = false;
      function update() {
        ticking = false;
        var idx = Math.round(sc.scrollLeft / sc.clientWidth);
        idx = Math.max(0, Math.min(idx, (colors ? colors.c.length : 1) - 1));
        var c = colors ? colors.c[idx] : null;
        if (c && chipColor) chipColor.textContent = colors.t + ' ' + c.color;
        li.dataset.activeColor = c ? c.color : '';
        Array.prototype.forEach.call(dots, function (d, i) { d.classList.toggle('is-on', i === idx); });
      }
      sc.addEventListener('scroll', function () {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      }, { passive: true });
      update();
    }

    /* ---- quick add ---- */
    var qs = document.getElementById('MelvaQuickAdd');
    var lastFocus = null;
    var current = null; /* { sizes, color, price, img, title } */

    function openSheet(item, color) {
      current = { item: item, color: color };
      lastFocus = document.activeElement;
      var card = qs.querySelector('.melva-qs__card');
      qs.querySelector('.melva-qs__title').textContent = item.t + ' · ' + color;
      var meta = item.c.filter(function (c) { return c.color === color; })[0];
      current.price = meta.price;
      current.sizes = meta.sizes;
      current.img = meta.img;
      var img = qs.querySelector('.melva-qs__img');
      if (meta.img) { img.src = meta.img; img.hidden = false; } else { img.hidden = true; }
      qs.querySelector('.melva-qs__price').textContent = meta.price;
      var wrap = qs.querySelector('.melva-qs__sizes');
      wrap.innerHTML = '';
      meta.sizes.forEach(function (s) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'melva-qs__size';
        b.textContent = s.s;
        b.dataset.vid = s.id;
        if (!s.a) { b.disabled = true; b.classList.add('is-out'); }
        b.addEventListener('click', function () {
          Array.prototype.forEach.call(wrap.children, function (x) { x.classList.remove('is-sel'); });
          b.classList.add('is-sel');
          qs.querySelector('[data-qs-add]').disabled = false;
        });
        wrap.appendChild(b);
      });
      qs.querySelector('[data-qs-add]').disabled = meta.sizes.length === 1 ? false : true;
      if (meta.sizes.length === 1) wrap.children[0].classList.add('is-sel');
      qs.querySelector('.melva-qs__done').hidden = true;
      qs.hidden = false;
      document.body.style.overflow = 'hidden';
      var first = wrap.querySelector('button:not([disabled])');
      if (first) first.focus();
    }

    function closeSheet() {
      qs.hidden = true;
      document.body.style.overflow = '';
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    qs.addEventListener('click', function (e) {
      if (e.target.closest('[data-qs-close]')) closeSheet();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !qs.hidden) closeSheet();
      if (e.key === 'Tab' && !qs.hidden) {
        var f = Array.prototype.filter.call(qs.querySelectorAll('button'), function (x) { return !x.disabled; });
        if (!f.length) return;
        if (e.shiftKey && document.activeElement === f[0]) { e.preventDefault(); f[f.length - 1].focus(); }
        else if (!e.shiftKey && document.activeElement === f[f.length - 1]) { e.preventDefault(); f[0].focus(); }
      }
    });

    function updateCartBubble() {
      fetch('/cart.js').then(function (r) { return r.json(); }).then(function (j) {
        var link = document.querySelector('a[href*="/cart"]');
        if (!link) return;
        var bubble = link.querySelector('.cart-count-bubble span[aria-hidden="true"]');
        if (!bubble) {
          var b = document.createElement('div');
          b.className = 'cart-count-bubble';
          b.innerHTML = '<span aria-hidden="true">' + j.item_count + '</span><span class="visually-hidden">' + j.item_count + ' articulos</span>';
          link.appendChild(b);
        } else {
          bubble.textContent = j.item_count;
        }
      });
    }

    qs.querySelector('[data-qs-add]').addEventListener('click', function () {
      var sel = qs.querySelector('.melva-qs__size.is-sel');
      if (!sel) return;
      var btn = this;
      btn.disabled = true;
      btn.textContent = 'Agregando…';
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: parseInt(sel.dataset.vid, 10), quantity: 1 }] })
      })
        .then(function (r) { return r.json(); })
        .then(function (res) {
          if (res.status) throw new Error(res.description || 'error');
          qs.querySelector('.melva-qs__done').hidden = false;
          updateCartBubble();
          try { if (window.gtag) window.gtag('event', 'feed_add_to_cart', { product: current.item.h }); } catch (e) {}
          setTimeout(closeSheet, 1100);
        })
        .catch(function () {
          btn.textContent = 'Agregar al carrito';
          btn.disabled = false;
        })
        .then(function () { btn.textContent = 'Agregar al carrito'; btn.disabled = false; });
    });

    /* swipe por color en cada tile */
    Array.prototype.forEach.call(cells, bindScroller);

    /* delegación para los botones + de cada tile */
    document.addEventListener('click', function (e) {
      var plus = e.target.closest('[data-qs-open]');
      if (!plus) return;
      e.preventDefault();
      e.stopPropagation();
      var li = plus.closest('.melva-feed__cell');
      var item = window.MELVA_FEED.items.filter(function (x) { return x.h === li.dataset.handle; })[0];
      if (!item) return;
      var activeColor = li.dataset.activeColor || item.c[0].color;
      if (item.c.length === 1 && item.c[0].sizes.length === 1) {
        /* única variación: agregar directo */
        var s = item.c[0].sizes[0];
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [{ id: s.id, quantity: 1 }] })
        }).then(function (r) { return r.json(); }).then(function (res) {
          if (res.status) throw new Error('x');
          plus.textContent = '✓';
          updateCartBubble();
          setTimeout(function () { plus.textContent = '+'; }, 1400);
        }).catch(function () {});
        return;
      }
      openSheet(item, activeColor);
    });
  })();
  </script>
</section>
{%- endif -%}

{% style %}
.melva-feed {
  padding: 3px 0 88px;
  background: #ffffff;
}
.melva-feed__heading {
  margin: 0 0 4px;
  color: #1a1a1a;
  font-size: clamp(1.5rem, 3.5vw, 2.25rem);
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.1;
}
.melva-feed__sub {
  margin: 0;
  color: rgba(26, 26, 26, 0.65);
  font-size: 0.9375rem;
  line-height: 1.5;
}
.melva-feed__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4px;
  padding: 0;
  margin: 0;
  list-style: none;
}
.melva-feed__cell a {
  position: relative;
  display: block;
  overflow: hidden;
}
.melva-tile__scroller {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  aspect-ratio: 1 / 1;
  overscroll-behavior-x: contain;
}
.melva-tile__scroller::-webkit-scrollbar { display: none; }
.melva-tile__img {
  width: 100%;
  flex: 0 0 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  display: block;
  scroll-snap-align: start;
  scroll-snap-stop: always;
  transition: transform 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.melva-feed__cell a:hover .melva-tile__img,
.melva-feed__cell a:focus-visible .melva-tile__img {
  transform: scale(1.07);
}
.melva-tile__dots {
  position: absolute;
  top: 8px;
  right: 8px;
  z-index: 2;
  display: flex;
  gap: 4px;
}
.melva-tile__dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: rgba(255, 255, 255, .55);
  box-shadow: 0 0 3px rgba(0, 0, 0, .25);
}
.melva-tile__dot.is-on { background: #ffffff; }
/* entrada al scroll: fade + rise con delay/offset aleatorios */
.melva-feed__cell {
  opacity: 0;
  transform: translateY(14px) translateX(var(--x, 0));
  transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1), transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  transition-delay: var(--d, 0ms);
}
.melva-feed__cell.is-in {
  opacity: 1;
  transform: none;
}
.melva-feed__badge {
  position: absolute;
  top: 8px;
  left: 8px;
  z-index: 2;
  padding: 3px 8px;
  color: #ffffff;
  background: #1a1a1a;
  font-size: 0.6563rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  line-height: 1.2;
}
.melva-feed__overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: flex-end;
  opacity: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0) 55%);
  transition: opacity 0.25s ease;
  pointer-events: none;
}
.melva-feed__cell a:hover .melva-feed__overlay,
.melva-feed__cell a:focus-visible .melva-feed__overlay {
  opacity: 1;
}
.melva-feed__meta {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 10px 12px;
  color: #ffffff;
  width: 100%;
}
.melva-feed__title {
  font-size: 0.8125rem;
  font-weight: 600;
  line-height: 1.3;
}
.melva-feed__price {
  font-size: 0.75rem;
  opacity: 0.85;
}
.melva-feed__price s {
  opacity: 0.6;
  margin-right: 4px;
}
/* chip de precio siempre visible (discreto) + botón + */
.melva-feed__chip {
  position: absolute;
  left: 8px;
  bottom: 8px;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 1px;
  color: #fff;
  text-shadow: 0 1px 6px rgba(0, 0, 0, .45);
  pointer-events: none;
}
.melva-feed__chip-t { font-size: 0.6875rem; font-weight: 600; line-height: 1.25; }
.melva-feed__chip-p { font-size: 0.6563rem; opacity: .92; }
.melva-feed__plus {
  position: absolute;
  right: 8px;
  bottom: 8px;
  z-index: 3;
  width: 44px;
  height: 44px;
  border: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, .92);
  color: #121212;
  font-size: 20px;
  font-weight: 600;
  line-height: 1;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(0, 0, 0, .18);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease, background 0.2s ease;
}
.melva-feed__plus:hover { transform: scale(1.08); background: #fff; }
/* hoja de quick-add */
.melva-qs { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1000; }
.melva-qs__backdrop { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, .6); display: block !important; }
.melva-qs__card {
  position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
  background: #fff; border-radius: 14px; padding: 20px 18px 18px;
  width: min(92vw, 360px); max-height: 90vh; overflow: auto;
  box-shadow: 0 18px 60px rgba(0, 0, 0, .35);
}
.melva-qs__x {
  position: absolute; right: 4px; top: 4px; background: rgba(255, 255, 255, .82); border: 0; border-radius: 50%;
  width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;
  font-size: 17px; cursor: pointer; color: #121212; box-shadow: 0 1px 4px rgba(0, 0, 0, .15);
}
.melva-qs__img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 10px; display: block; margin-bottom: 12px; }
.melva-qs__title { margin: 0 0 4px; font-size: 16px; font-weight: 600; color: #121212; }
.melva-qs__price { margin: 0 0 14px; font-size: 13.5px; color: #5f5f5f; }
.melva-qs__sizes { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
.melva-qs__size {
  min-width: 48px; min-height: 44px; padding: 6px 12px;
  border: 1px solid rgba(0, 0, 0, .2); border-radius: 8px;
  background: none; font: inherit; font-size: 14px; cursor: pointer; color: #121212;
}
.melva-qs__size.is-sel { border-color: #121212; border-width: 2px; font-weight: 600; }
.melva-qs__size.is-out { opacity: .35; text-decoration: line-through; cursor: not-allowed; }
.melva-qs__add { margin-bottom: 8px; }
.melva-qs__done { text-align: center; font-size: 13.5px; color: #1a7a2e; margin: 4px 0 0; }
@media (max-width: 767px) {
  .melva-feed { padding: 2px 0 64px; }
  .melva-feed__grid { grid-template-columns: repeat(2, 1fr); gap: 3px; }
  .melva-feed__overlay { opacity: 1; background: linear-gradient(to top, rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0) 60%); }
  .melva-feed__meta { padding: 7px 8px; }
  .melva-feed__title { font-size: 0.6875rem; }
  .melva-feed__price { font-size: 0.6563rem; }
  .melva-qs__card { left: 50%; right: auto; top: auto; bottom: 0; transform: none; width: 100%; max-width: none; border-radius: 14px 14px 0 0; }
}
@media (hover: none) {
  .melva-feed__overlay { opacity: 1; }
}
@media (prefers-reduced-motion: reduce) {
  .melva-feed__cell { opacity: 1; transform: none; transition: none; }
  .melva-tile__img { transition: none; }
}
{% endstyle %}

{% schema %}
{
  "name": "Feed Melva",
  "tag": "section",
  "class": "section melva-feed-section",
  "disabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "En las calles" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Tocá una foto para ver la prenda." },
    {
      "type": "checkbox",
      "id": "prioritize_sale",
      "label": "Priorizar productos en oferta",
      "info": "Los productos con descuento aparecen primero, con badge.",
      "default": true
    },
    {
      "type": "range",
      "id": "max_tiles",
      "label": "Cantidad de fotos",
      "min": 6,
      "max": 30,
      "step": 6,
      "default": 18
    }
  ],
  "presets": [{ "name": "Feed Melva" }]
}
{% endschema %}
